<configuration>

	<connectionStrings>
		<add
		  name="ProductionBoardConnection"
		  connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=productionboard_db;Integrated Security=True;TrustServerCertificate=True"
		  providerName="System.Data.SqlClient" />
	</connectionStrings>

	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<system.web>

		<compilation
		  debug="true"
		  targetFramework="4.7.2" />

		<httpRuntime
		  targetFramework="4.7.2" />

		<authentication mode="Forms">
			<forms
			  name=".ProductionBoardAuth"
			  loginUrl="Login.aspx"
			  defaultUrl="BoardSetup.aspx"
			  timeout="480"
			  slidingExpiration="true"
			  protection="All"
			  cookieless="UseCookies"
			  requireSSL="false" />
		</authentication>

		<authorization>
			<deny users="?" />
		</authorization>

		<sessionState timeout="60" />

		<httpCookies
		  httpOnlyCookies="true"
		  sameSite="Lax"
		  requireSSL="false" />

	</system.web>

</configuration>